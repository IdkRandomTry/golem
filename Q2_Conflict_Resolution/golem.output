Terminals unused in grammar

    TRUE
    FALSE
    STRING_LITERAL


Grammar

    0 $accept: program $end

    1 program: ε
    2        | program statement

    3 statement: grid_decl
    4          | blueprint_decl
    5          | construct_decl
    6          | ';'

    7 grid_decl: GRID '(' expr ',' expr ')' '{' obstacle_list '}'

    8 obstacle_list: ε
    9              | obstacle_list obstacle_stmt

   10 obstacle_stmt: OBSTACLE '(' expr ',' expr ')' ';'

   11 blueprint_decl: BLUEPRINT IDENTIFIER '{' stmt_list '}'

   12 construct_decl: CONSTRUCT '{' spawn_list '}'

   13 spawn_list: ε
   14           | spawn_list spawn_stmt

   15 spawn_stmt: SPAWN IDENTIFIER AT '(' expr ',' expr ')' ';'
   16           | SPAWN IDENTIFIER AS IDENTIFIER AT '(' expr ',' expr ')' ';'

   17 stmt_list: ε
   18          | stmt_list stmt

   19 stmt: movement_stmt
   20     | rotation_stmt
   21     | pick_stmt
   22     | drop_stmt
   23     | conditional_stmt
   24     | repetition_stmt
   25     | compound_stmt

   26 compound_stmt: '{' stmt_list '}'

   27 movement_stmt: GO expr ';'

   28 rotation_stmt: TURN direction ';'

   29 pick_stmt: PICK IDENTIFIER ';'

   30 drop_stmt: DROP IDENTIFIER ';'

   31 conditional_stmt: IF '(' condition ')' stmt
   32                 | IF '(' condition ')' stmt ELSE stmt

   33 repetition_stmt: REPEAT expr compound_stmt
   34                | REPEAT compound_stmt
   35                | REPEAT expr ';'

   36 condition: SCAN '(' direction '?' ')' EQ_OP scan_result
   37          | SCAN '(' direction '?' ')' NE_OP scan_result
   38          | directional_scan EQ_OP scan_result
   39          | directional_scan NE_OP scan_result

   40 directional_scan: EAST_SCAN
   41                 | WEST_SCAN
   42                 | NORTH_SCAN
   43                 | SOUTH_SCAN

   44 scan_result: OBSTACLE
   45            | EMPTY

   46 direction: NORTH
   47          | SOUTH
   48          | EAST
   49          | WEST

   50 expr: INTEGER
   51     | expr PLUS expr
   52     | expr MINUS expr
   53     | MINUS expr
   54     | expr MULTIPLY expr
   55     | expr DIVIDE expr
   56     | expr MODULO expr
   57     | '(' expr ')'


